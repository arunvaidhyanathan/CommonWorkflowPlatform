  "cards": [
    {
      "dot": "rose",
      "title": "Trust",
      "items": [
        "identity-service signs login tokens (RS256) with one shared key; every service verifies them against its JWKS",
        "The gateway routes and rate-limits per client IP; it never validates tokens and refuses /internal/**",
        "Internal calls carry the shared X-Internal-Token"
      ]
    },
    {
      "dot": "violet",
      "title": "Who may write",
      "items": [
        "design-service and flowable-wrapper re-check role and status with identity-service on every write, cached up to 30s per pod",
        "If identity-service is down, writes fail with 503 instead of trusting the token"
      ]
    },
    {
      "dot": "emerald",
      "title": "Scale and data",
      "items": [
        "Every service is a stateless image that scales horizontally behind its own Service",
        "One database, one schema and login role per service, no cross-schema foreign keys: any service can move to its own database",
        "flowable-wrapper and spend-tracker create their own tables at startup under a lock"
      ]
    }
  ]
