# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase (required -- the app throws at startup without these)
VITE_SUPABASE_URL=https://nrhsoabqeskybrznxfyi.supabase.co
VITE_SUPABASE_ANON_KEY=

# Runtime Gateway (optional -- only needed for the Publish button in
# Designer, WorkflowWrapper.html Section 9 Phase 2). Leave unset until the
# service in WaaS/Workflow-Wrapper is actually built and deployed
# somewhere; Publish will show a clear "not configured" message instead of
# failing confusingly if this is blank.
VITE_RUNTIME_GATEWAY_URL=http://localhost:8081
