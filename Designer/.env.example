# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase (required -- the app throws at startup without these)
VITE_SUPABASE_URL=https://nrhsoabqeskybrznxfyi.supabase.co
VITE_SUPABASE_ANON_KEY=

# CWP API (optional -- only needed for Publish and the Workflow Wrapper
# screens). This is the nginx edge gateway's /api prefix: run
# `docker compose up` at the repo root, then use the value below for Vite
# dev. The gateway-served build sets it to /api itself. Leave unset and those
# screens show a clear "not configured" message instead of failing.
VITE_API_BASE_URL=http://localhost:8080/api
