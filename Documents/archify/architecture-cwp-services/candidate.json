  "cards": [
    { "dot": "rose", "title": "Trust", "items": ["identity-service signs login tokens (RS256); every service verifies them against its JWKS", "nginx routes only; it never validates tokens or routes /internal/**", "Internal calls carry the shared X-Internal-Token"] },
    { "dot": "violet", "title": "Who may write", "items": ["design-service and flowable-wrapper re-check role and status with identity-service on every write, cached up to 30s", "If identity-service is down, writes fail with 503 instead of trusting the token"] },
    { "dot": "emerald", "title": "Data ownership", "items": ["One Postgres, three login roles: each service is refused on the others' tables", "Role and status changes are posted to design-service's audit log inside the change's transaction", "spend-tracker keeps its own database"] }
