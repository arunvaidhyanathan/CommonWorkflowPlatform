# Copy to .env (git-ignored) for `docker compose up`. Local values only; on
# OpenShift every secret below comes from a Secret (docs/deployment-openshift.md).

# Host port for the gateway (the stack's single entry point).
GATEWAY_PORT=8080

# PostgreSQL: the admin password and one password per service role. Set once,
# before the first `docker compose up`: roles are created with the volume.
CWP_POSTGRES_ADMIN_PASSWORD=change-me
CWP_IDENTITY_DB_PASSWORD=change-me-identity
CWP_DESIGN_DB_PASSWORD=change-me-design
CWP_RUNTIME_DB_PASSWORD=change-me-runtime
CWP_SPEND_DB_PASSWORD=change-me-spend

# Shared by the services that call each other's /internal API.
CWP_INTERNAL_TOKEN=change-me
# Token the agent uses to post usage events to spend-tracker.
SPEND_INGEST_TOKEN=change-me

# identity-service's token signing key (PKCS#8 PEM). Empty locally: a
# throwaway key per start (CWP_JWT_ALLOW_EPHEMERAL_KEY defaults to true in
# compose). Generate: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
CWP_JWT_PRIVATE_KEY=

# Regex of browser origins allowed to call /api/* cross-origin (Vite dev).
CORS_ALLOWED_ORIGINS=^http://localhost:5173$

# Agentic Designer LLM provider: gemini | nvidia | openrouter. Without the
# chosen provider's key the service still starts and /generate returns 503.
AGENT_PROVIDER=gemini
# Empty = the provider's default model.
AGENT_MODEL=
# Optional model for Edit mode only (empty = AGENT_MODEL).
AGENT_EDIT_MODEL=
GEMINI_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
# Generate requests per tenant per minute (per agentic-designer replica).
AGENT_TENANT_RPM=10

# Spend tracker: user ids allowed platform-wide spend and key health (comma
# separated); tenant admins always see their own tenant. Key-check interval
# in seconds (0 = off).
SPEND_ADMIN_USER_IDS=
SPEND_KEY_CHECK_INTERVAL_S=3600
TYPESAFE_JEV_API_KEY=
