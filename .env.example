# Copy to .env (gitignored) for `docker compose up`.
# The SPA's own Supabase settings come from Designer/.env.local.

# Host port for the gateway (the stack's single entry point).
GATEWAY_PORT=8080

# Password for the local runtime-db container (any value; local only).
WORKFLOW_RUNTIME_DB_PASSWORD=change-me
# One login role per service in runtime-db (Database/roles.sql). Set once,
# before the first `docker compose up`: they are applied when the volume is created.
CWP_IDENTITY_DB_PASSWORD=change-me-identity
CWP_DESIGN_DB_PASSWORD=change-me-design
CWP_RUNTIME_DB_PASSWORD=change-me-runtime

# Regex of browser origins allowed to call /api/* cross-origin (Vite dev).
CORS_ALLOWED_ORIGINS=^http://localhost:5173$

# Agentic Designer LLM provider: gemini | nvidia | openrouter.
# Leave the chosen provider's key empty and the service still starts;
# /generate returns 503. A key exported in your shell overrides this file.
AGENT_PROVIDER=gemini
# Empty = the provider's default (gemini-3.8-flash, moonshotai/kimi-k3,
# google/gemini-3.8-flash).
AGENT_MODEL=
# Optional model for Edit mode only (empty = AGENT_MODEL). Measured on NVIDIA
# 2026-09-27: kimi-k3 with empty-reply retries 4/4 valid edits in 28-48s;
# glm-5.3 valid but 115-300s+ with timeouts. See AgenticDesigner.html 4b.
AGENT_EDIT_MODEL=
GEMINI_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
# Generate requests per tenant per minute.
AGENT_TENANT_RPM=10

# API spend tracker (Documents/SpendTracker.html).
# Local spend-db password and the token services use to post usage events.
SPEND_DB_PASSWORD=change-me
SPEND_INGEST_TOKEN=change-me
# Comma-separated Supabase user ids that may see platform-wide spend and key
# health. Tenant admins always see their own tenant's spend.
SPEND_ADMIN_USER_IDS=
SPEND_KEY_CHECK_INTERVAL_S=3600
# Checked by the tracker (the Gemini/NVIDIA/OpenRouter keys above are too).
TYPESAFE_JEV_API_KEY=

# Agentic Designer grounding in the tenant's own workflows (on | off). Uses
# the same Supabase URL and public (anon/publishable) key as the browser app.
AGENT_GROUNDING=off
SUPABASE_URL=
SUPABASE_ANON_KEY=
# nvidia (default model nvidia/nemotron-3-embed-1b) or gemini (gemini-embedding-001)
AGENT_EMBED_PROVIDER=nvidia
AGENT_EMBED_MODEL=

# Shared by identity-service and the services that call its /internal API.
CWP_INTERNAL_TOKEN=change-me
# identity-service's token signing key (PKCS#8 PEM, one line with \n or quoted
# multi-line). Leave empty locally: a throwaway key is generated per start.
CWP_JWT_PRIVATE_KEY=
