# Copy to .env (gitignored) for `docker compose up`.
# The SPA's own Supabase settings come from Designer/.env.local.

# Host port for the gateway (the stack's single entry point).
GATEWAY_PORT=8080

# Password for the local runtime-db container (any value; local only).
WORKFLOW_RUNTIME_DB_PASSWORD=change-me

# Supabase Auth JWKS endpoint the services verify JWTs against:
# https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=https://nrhsoabqeskybrznxfyi.supabase.co/auth/v1/.well-known/jwks.json
# jwks (default) or hs256 for projects still on the legacy shared secret.
SUPABASE_JWT_MODE=jwks
SUPABASE_JWT_HS256_SECRET=

# Regex of browser origins allowed to call /api/* cross-origin (Vite dev).
CORS_ALLOWED_ORIGINS=^http://localhost:5173$

# Agentic Designer LLM provider: gemini | nvidia | openrouter.
# Leave the chosen provider's key empty and the service still starts;
# /generate returns 503. A key exported in your shell overrides this file.
AGENT_PROVIDER=gemini
# Empty = the provider's default (gemini-3.8-flash, moonshotai/kimi-k3,
# google/gemini-3.8-flash).
AGENT_MODEL=
GEMINI_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
# Generate requests per tenant per minute.
AGENT_TENANT_RPM=10
